rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // users/{uid}/profile/avatar.jpg — a student's profile picture.
    // Publicly readable (avatars are shown to other students in Chat),
    // but only the owner can upload/replace their own.
    match /users/{uid}/profile/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // users/{uid}/listings/{listingId}/{fileName} — photos attached to
    // a listing posted by this user. Publicly readable (they're shown
    // on public marketplace listings), but only the owning seller can
    // upload/replace them.
    match /users/{uid}/listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else is private by default (no matching rule = denied).
  }
}
