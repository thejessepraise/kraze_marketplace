rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USERS:
    // Anyone logged in can READ a profile.
    // Only the owner can WRITE.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /favorites/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // PRODUCTS:
    // Publicly readable.
    // Only the seller can create, update, or delete.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
    }

    // CONVERSATIONS & MESSAGES:
    // Simplified to ensure messaging and "Last Message" updates work reliably.
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
