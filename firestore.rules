rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow read, update: if isOwner(userId);
      allow delete: if false;
      match /favorites/{productId} { allow read, write: if isOwner(userId); }
    }
    match /products/{productId} {
      allow read: if resource.data.isAvailable == true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid && request.resource.data.price is number && request.resource.data.price > 0;
      allow update, delete: if signedIn() && resource.data.sellerId == request.auth.uid && (request.method == 'delete' || request.resource.data.sellerId == resource.data.sellerId);
    }
    match /conversations/{id} { allow read, create, update: if signedIn() && request.auth.uid in request.resource.data.participants; match /messages/{messageId} { allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants; allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants; } }
  }
}
